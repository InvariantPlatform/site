// Cloudflare Workers: `next build` writes out/ and src/worker.ts serves it,
// after one check (see the script). When the members routes arrive
// (ADR-185), the route gate is added to the same script, in front of the
// same assets — nothing about the site's build changes.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invariant-platform",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Without this, a request that matches a file is answered before the
    // script runs, and the script only sees misses. The redirect (and later
    // the members gate) must see every request.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // ADR-194: the nightly posture-check publishes `posture` here; the Worker
  // fills the status strip from it. Namespace "invariant-platform-status".
  // Without the binding the Worker serves normally and the strip reads
  // "no run recorded".
  "kv_namespaces": [{ "binding": "STATUS", "id": "309b621a476d4bb1aced7b36e5d798c4" }],
  "vars": {
    // The zone went active 2026-09-14 21:16 (registry delegation + Universal SSL).
    // Empty would mean: serve on every hostname, no redirect.
    "CANONICAL_HOST": "invariant-platform.io",
    // The members gate and join flow (ADR-210, src/gate). None of these is a
    // secret; the App's client secret, private key, SESSION_SECRET and
    // BUTTONDOWN_API_KEY are Worker secrets, set in the dashboard. The App
    // "invariant-platform-members" holds ONE permission: Organization
    // members, write (read back 2026-11-12: no other permission, no events).
    "GITHUB_ORG": "InvariantPlatform",
    "GITHUB_APP_ID": "5726583",
    "GITHUB_APP_CLIENT_ID": "Iv23liReufa92bz25es0",
    "GITHUB_APP_INSTALLATION_ID": "181205606"
  }
}
